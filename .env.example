# JourneyMind configuration. Every value here has a working default —
# the application starts with this file absent. There are no secrets.

# --- data ------------------------------------------------------------------
# Serve entirely from the bundled study-area bundle and never contact an
# external feed. This is the only mode the deployed MVP supports.
DEMO_MODE=true
# bengaluru_south = the bundled synthetic corridor (default, no network needed)
# bengaluru_osm   = the real OpenStreetMap corridor built by scripts/fetch_osm.py
#                   Pair it with JM_MODELS_DIR=models_osm, which holds the
#                   weights trained on that bundle.
JM_CITY=bengaluru_south
# JM_DATA_DIR=./data
# JM_MODELS_DIR=./models

# --- model -----------------------------------------------------------------
# graphsage | gat | mlp | historical | freeflow   (gbt is offline-evaluation only)
# Default is gat. The graph-free MLP measures slightly better on the bundled
# test split -- set JM_MODEL=mlp to serve it and compare. See EVALUATION.md.
JM_MODEL=gat
# Used when the requested model's weights are missing or fail to load.
JM_MODEL_FALLBACK=historical

# --- routing / optimisation ------------------------------------------------
JM_K_CANDIDATES=20
JM_MAX_ALTERNATIVES=2
# Longest FIRST/LAST-MILE hop to a hub. Past this a "quick hop to the metro"
# is not a quick hop.
JM_MAX_RIDE_KM=16
# Longest DOOR-TO-DOOR hailed ride. Separate from the hop cap on purpose: a
# rider can book one vehicle for any distance inside the corridor, and using
# one cap for both deleted the direct ride on long trips -- the router then
# replaced it with two hailed vehicles in a row.
JM_MAX_DIRECT_RIDE_KM=60
# How far a hailed vehicle will go to put you on a train or a bus. Rides could
# previously only reach a "hub"; the nearest one to some origins is several km
# away, which made every cheap multimodal journey start with a long walk.
JM_ACCESS_RIDE_KM=3.0
JM_ACCESS_RIDE_STOPS=8

# --- geocoding -------------------------------------------------------------
# Resolve typed place names that are not in the bundled list, via Nominatim
# (free, keyless, ODbL). Bounded to the study area, cached to disk, and falls
# back to the bundled list on any failure. Set to 0 for a fully offline build.
JM_GEOCODER=1
JM_GEOCODER_TIMEOUT=4.0
JM_MAX_ACCESS_WALK_KM=1.1
JM_WALK_SPEED_KMPH=4.6

# --- server ----------------------------------------------------------------
# Render sets PORT itself; do not hard-code it in production.
PORT=8000
HOST=0.0.0.0
# Comma-separated allowed origins, or * . The API is public, read-only and
# carries no credentials, so * is the default.
JM_CORS_ORIGINS=*
JM_SERVE_FRONTEND=true
JM_RATE_LIMIT_PER_MIN=60
LOG_LEVEL=INFO

# --- frontend (build time only) --------------------------------------------
# Leave unset in production: the API is served from the same origin.
# VITE_API_BASE=http://127.0.0.1:8011

# ===========================================================================
# Mobility intelligence layer
# ===========================================================================

# --- enterprise access -----------------------------------------------------
# Comma-separated "key:role" pairs. Roles: rider | analyst | admin.
# Enterprise endpoints expose POPULATION-level data and fail closed: with this
# unset and DEMO_MODE=false, they refuse every request. With this unset and
# DEMO_MODE=true, a single clearly-named demo key is enabled and announced in
# /health, so a demo can never be mistaken for a configured deployment.
#
# SET THIS BEFORE DEPLOYING ANYWHERE REAL.
# JM_API_KEYS=change-me-analyst:analyst,change-me-admin:admin

# Append every recorded AI decision to a JSONL file as well as the in-memory
# ring buffer. Unset means in-memory only (lost on restart).
# JM_AUDIT_LOG=/var/log/journeymind/audit.jsonl

# --- request limits --------------------------------------------------------
# Basic abuse hygiene on a public, unauthenticated endpoint. A request outside
# these bounds is rejected with a 422 rather than being clamped silently.
# JM_MAX_BUDGET=100000
# JM_MAX_TIME_MIN=1440

# --- serving ---------------------------------------------------------------
# Where the built frontend lives. The Dockerfile sets this; override only if
# you serve the bundle from somewhere else.
# JM_STATIC_DIR=./backend/app/static

# --- expected-cost model ---------------------------------------------------
# These are behavioural ASSUMPTIONS, exposed so they can be fitted rather than
# argued about. Defaults live in backend/app/lifecycle/expected_cost.py.
# JM_MAX_BOOKING_ATTEMPTS=3
# JM_SURGE_PER_RETRY=0.18

# --- enterprise costing ----------------------------------------------------
# What a minute of an employee's time is worth to the employer, in rupees.
# Used only to convert minutes lost to failed bookings into money. The minutes
# are counted; this rate is an assumption.
# JM_MINUTE_COST=6.0
